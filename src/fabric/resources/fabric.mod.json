      "com.memeemoji.platform.FabricEntrypoint"
    ],
    "client": [
      "com.memeemoji.platform.ClientPlatform"
    ]
  },
  "mixins": [
    "memeemoji.mixins.json",
    "memeemoji-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
